{
  "name": "freedom-card-designer",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:migrate": "tsx src/server/db/migrate.ts",
    "db:seed": "tsx --env-file-if-exists=.env.local src/server/db/seed.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "e2e": "playwright test",
    "fonts:metrics": "tsx scripts/gen-font-metrics.ts",
    "import:workbook": "tsx --env-file-if-exists=.env.local scripts/import-workbook.ts",
    "seed:benchmark": "tsx --env-file-if-exists=.env.local scripts/seed-benchmark.ts",
    "seed:assets": "tsx --env-file-if-exists=.env.local scripts/seed-assets.ts",
    "bootstrap": "tsx scripts/bootstrap-remote.ts",
    "seed:templates": "tsx --env-file-if-exists=.env.local scripts/seed-templates.ts",
    "samples": "tsx --env-file-if-exists=.env.local scripts/generate-samples.ts",
    "test:integration": "tsx --env-file-if-exists=.env.test vitest run --config vitest.integration.config.mts",
    "test:all": "npm run test && npm run test:integration",
    "import:aftermarket": "tsx --env-file-if-exists=.env.local scripts/import-aftermarket.ts"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "@vercel/blob": "^2.8.0",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "exceljs": "^4.4.0",
    "jose": "^6.2.10",
    "lucide-react": "^1.34.0",
    "nanoid": "^6.0.1",
    "next": "16.3.3",
    "pdf-lib": "^1.17.1",
    "pg": "^8.23.0",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "sharp": "^0.35.4",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.11",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5",
    "vitest": "^4.1.11"
  },
  "allowScripts": {
    "esbuild@0.18.20": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "unrs-resolver@1.12.2": true,
    "sharp@0.35.4": true
  }
}
